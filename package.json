{
  "name": "contextfootprint",
  "version": "0.1.0",
  "private": true,
  "description": "Pure assertion identity and conflict comparison for context integrity.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/footprintjs/contextfootprint.git" },
  "homepage": "https://github.com/footprintjs/contextfootprint#readme",
  "bugs": { "url": "https://github.com/footprintjs/contextfootprint/issues" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    }
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.esm.json --noEmit && tsc -p tsconfig.cjs.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:example": "node examples/compare.mjs",
    "test:package": "node scripts/packed-smoke.mjs",
    "verify": "npm run check && npm test && npm run test:example && npm run test:package"
  },
  "devDependencies": { "typescript": "5.9.3" }
}
